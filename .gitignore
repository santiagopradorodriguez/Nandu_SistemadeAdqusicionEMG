# ==============================================================================
# NANDU LSD - ARCHIVO DE EXCLUSION GLOBAL DE GIT (.gitignore)
# ==============================================================================

# --- DOCUMENTOS DE TESIS, CUADERNOS Y OFIMATICA PRIVADA ---
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.odt
documentos_tesis/
**/documentos_tesis/
cuaderno_tesis/
**/cuaderno_tesis/

# --- PRIVACIDAD Y DATOS BIOMETRICOS DE SUJETOS ---
# Bases de datos de registros bioelectricos y audio
base_de_datos_electrodos/
**/base_de_datos_electrodos/
base_de_datos_letras/
**/base_de_datos_letras/
Emg/base_de_datos_electrodos/
Emg/base_de_datos_letras/
EMG_desarrollo/base_de_datos_electrodos/
EMG_desarrollo/base_de_datos_letras/
*.wav

# Fotografias de rostros y calibracion con sujetos reales
**/fotos/*.jpeg
**/fotos/*.jpg
**/fotos/WhatsApp*
**/fotos/*candela*
**/fotos/*lucas*
**/fotos/*petra*
**/fotos/*sujeto*

# Excepciones para diagramas anatomicos de referencia medica y circuitos
!**/fotos/anatomia_*
!**/documentacion_hardware/imagenes/*
!EMG_desarrollo/fotos/anatomia_*
!EMG_desarrollo/documentacion_hardware/imagenes/*.png
!EMG_desarrollo/logo_nandu_lsd.png
!EMG_desarrollo/icono.ico

# --- DOCUMENTOS PDF, REPORTES Y ARTICULOS ACADEMICOS ---
*.pdf
reportes_experimentos/*.pdf
reportes_experimentos/analisis_pca_generado/
reportes_experimentos/evolucion_sesion*/
reportes_experimentos/imagenes_*/
reportes_experimentos/test_*.png
reportes_experimentos/page_preview-*.png
reportes_experimentos/debug_*.png
EMG_desarrollo/papers/
**/papers/

# Artefactos y archivos auxiliares de LaTeX
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*argv_log.txt

# --- ANALISIS, SESIONES Y RESULTADOS DE MEDICIONES ---
analisis_comparativos/
**/analisis_comparativos/
analisis_de_sesiones/
**/analisis_de_sesiones/
Emg/analisis_comparativos/
EMG_desarrollo/analisis_comparativos/
EMG_desarrollo/analisis_de_sesiones/
EMG_desarrollo/resultados/
**/resultados_pca_umap/
**/resultados_grid_search/
**/resultados_autoencoder/
**/resultados_umbrales/
**/archivo_historico/
resultados_barrido_ortogonal/
resultados_transferencia_nuevo_sujeto/
paquete_remoto_barrido/
archivos_temporales/
cache_datos/
**/cache_datos/

# Datos masivos, tablas y tensores de salida
*.npz
*.npy
*.csv
*.png
*.json
# Excepciones para archivos JSON de configuracion operativa del sistema
!config_general.json
!**/config_general.json
!metronome_config.json
!**/metronome_config.json
!DataConfig/modelos_vision/*
!EMG_desarrollo/DataConfig/modelos_vision/*

# --- MODELOS ENTRENADOS Y CHECKPOINTS DE DEEP LEARNING ---
*.pth
*.pt
*.onnx
*.pkl
*.joblib
*.h5

# --- CODIGOS Y SCRIPTS DE PRUEBA Y EXPERIMENTOS TEMPORALES ---
codigos_de_prueba/
**/codigos_de_prueba/
machine_learning/
EMG_desarrollo/temp_*.py
temp_*.py
**/temp_*.py
scratch/
**/scratch/

# --- CARPETAS DE RESPALDO Y HISTORIAL ---
respaldo_*/
**/respaldo_*/
nandu/

# --- ENTORNO DE DESARROLLO, CACHES Y COMPILACION ---
venv/
.venv/
.pytest_cache/
.vscode/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.patch

# Archivos comprimidos de backups
*.rar
*.zip
*.tar
*.tar.gz
*.7z

# Entornos y artefactos de compilacion PyInstaller
build_linux/*
!build_linux/.gitkeep
build_windows/*
!build_windows/.gitkeep
EMG_desarrollo/EMG_Ejecutable_Build/
dist/
**/dist/
build/
**/build/



