% Ejemplo para citar un repositorio de GitHub (ej. AI-for-Physics o tu propio repo)
@software{repo_github,
    author = {Apellido, Nombre or {Nombre de la Organización}},
    title = {Título del Repositorio},
    url = {https://github.com/usuario/repo},
    version = {1.0},
    date = {2025},
}

% Ejemplo para citar un manual interno o documento guardado en un Google Drive
@manual{manual_drive,
    author = {{Laboratorio de Sistemas Dinámicos}},
    title = {Bitácora de caracterización de la placa de 3 canales},
    year = {2025},
    note = {Documento interno de trabajo},
    url = {https://drive.google.com/drive/folders/...},
}

% Ejemplo para citar un reporte de laboratorio previo (ej. Labo 6)
@techreport{informe_labo6,
    author = {Braunstein, Lucas and Prado Rodriguez, Santiago},
    title = {Desarrollo e Implementación de un Sistema de Adquisición de Electromiografía Multicanal},
    institution = {FCEyN, Universidad de Buenos Aires},
    year = {2025},
    type = {Informe de Laboratorio},
}

% Ejemplo para citar un Datasheet de un componente electrónico (muy útil para hardware)
@manual{datasheet_opamp,
    organization = {Texas Instruments},
    title = {TL07xx Low-Noise JFET-Input Operational Amplifiers},
    year = {2021},
    number = {SLOS080J},
    url = {https://www.ti.com/lit/ds/symlink/tl074.pdf},
}
